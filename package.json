{
  "name": "zhiyuan-agent-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:marketing && npm run docs:content && npm run blog:content && vite",
    "generate:marketing": "node scripts/generate-marketing-pages.mjs",
    "docs:content": "node scripts/build-docs.mjs",
    "docs:emit": "node scripts/emit-docs-pages.mjs",
    "blog:content": "node scripts/build-blog.mjs",
    "blog:emit": "node scripts/emit-blog-pages.mjs",
    "build": "npm run generate:marketing && npm run docs:content && npm run blog:content && npm run typecheck:functions && tsc && vite build && npm run docs:emit && npm run blog:emit",
    "typecheck:functions": "tsc --project tsconfig.functions.json",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler pages deploy dist --project-name rongxzyai-pages --branch main"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@shikijs/rehype": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "gray-matter": "^4.0.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "unified": "^11.0.5",
    "vite": "^6.0.0",
    "wrangler": "^4.104.0"
  }
}
