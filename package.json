{
  "name": "zhiyuan-agent-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:marketing && vite",
    "generate:marketing": "node scripts/generate-marketing-pages.mjs",
    "build": "npm run generate:marketing && npm run typecheck:functions && tsc && vite build && npm run docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "typecheck:functions": "tsc --project tsconfig.functions.json",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler pages deploy dist --project-name rongxzyai-pages --branch main"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitepress": "^1.6.4",
    "wrangler": "^4.104.0"
  }
}
